<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!-- VRE constructs adult Androids at age zero; its native life stage remains authoritative. -->
  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/*[defName="VREA_SyntheticBody" and geneClass="VREAndroids.Gene_SyntheticBody" and not(modExtensions/li[@Class="RimRound.Utilities.HelperIdentityExtension"])]</xpath>
    <match Class="PatchOperationConditional">
      <xpath>/Defs/*[defName="VREA_SyntheticBody" and geneClass="VREAndroids.Gene_SyntheticBody"]/modExtensions</xpath>
      <match Class="PatchOperationAdd">
        <xpath>/Defs/*[defName="VREA_SyntheticBody" and geneClass="VREAndroids.Gene_SyntheticBody"]/modExtensions</xpath>
        <value><li Class="RimRound.Utilities.HelperIdentityExtension"><constructedAdult>true</constructedAdult></li></value>
      </match>
      <nomatch Class="PatchOperationAdd">
        <xpath>/Defs/*[defName="VREA_SyntheticBody" and geneClass="VREAndroids.Gene_SyntheticBody"]</xpath>
        <value><modExtensions><li Class="RimRound.Utilities.HelperIdentityExtension"><constructedAdult>true</constructedAdult></li></modExtensions></value>
      </nomatch>
    </match>
  </Operation>
</Patch>

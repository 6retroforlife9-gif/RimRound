<?xml version="1.0" encoding="utf-8" ?>
<Patch>
  <!-- Each dispensed serving carries its own density and ingredient history. -->
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ThingDef[defName="RR_FeedingTubeFluid"]/comps</xpath>
    <value>
      <li Class="CompProperties_Ingredients">
        <compClass>CompIngredients</compClass>
      </li>
      <li Class="RimRound.FeedOther.CompProperties_FoodNetworkServing">
        <compClass>RimRound.FeedOther.CompFoodNetworkServing</compClass>
      </li>
    </value>
  </Operation>

  <!-- Pawn-operated dispensers now create a genuine vanilla nutrient-paste
       meal. The extra component is dormant on ordinary paste and stores exact
       nutrition/density only on meals drawn from Food Network v2. -->
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ThingDef[defName="MealNutrientPaste"]/comps</xpath>
    <value>
      <li Class="RimRound.FeedOther.CompProperties_FoodNetworkServing">
        <compClass>RimRound.FeedOther.CompFoodNetworkServing</compClass>
      </li>
    </value>
  </Operation>

  <!-- XL processors can accept meals when the player enables them. Keep raw-only
       defaults below; widening capability must not rewrite saved food choices. -->
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="RR_Hopper"]/building/fixedStorageSettings</xpath>
    <value>
      <fixedStorageSettings>
        <priority>Important</priority>
        <filter>
          <categories>
            <li>Foods</li>
          </categories>
          <specialFiltersToDisallow>
            <li>AllowPlantFood</li>
          </specialFiltersToDisallow>
          <disallowedThingDefs>
            <li>Hay</li>
            <li MayRequire="Ludeon.RimWorld.Biotech">HemogenPack</li>
          </disallowedThingDefs>
        </filter>
      </fixedStorageSettings>
    </value>
  </Operation>

  <!-- Native groups inherit their first member's fixed filter. XL capabilities
       must not leak into vanilla hoppers or inherit vanilla's raw-only cap. -->
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="RR_Hopper"]/building/storageGroupTag</xpath>
    <value><storageGroupTag>RR_ProcessorHopper</storageGroupTag></value>
  </Operation>

  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="RR_Hopper"]/building/defaultStorageSettings</xpath>
    <value>
      <defaultStorageSettings>
        <priority>Important</priority>
        <filter>
          <categories>
            <li>FoodRaw</li>
          </categories>
          <disallowedThingDefs>
            <li>Meat_Human</li>
            <li>Meat_Megaspider</li>
            <li MayRequire="Ludeon.RimWorld.Anomaly">Meat_Twisted</li>
          </disallowedThingDefs>
        </filter>
      </defaultStorageSettings>
    </value>
  </Operation>

  <!-- The valve is a switch, so its Architect-menu icon should match the
       familiar vanilla power-switch graphic instead of a conduit. -->
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="RR_TD_FeedingTubeValve"]/uiIconPath</xpath>
    <value>
      <uiIconPath>Things/Building/Power/PowerSwitch</uiIconPath>
    </value>
  </Operation>

  <!-- Both storage modes share the same fixed input and output geometry. -->
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="RR_TD_NutrientDistillery"]/placeWorkers/li[text()="RimRound.FeedingTube.NutrientDistillery_PlaceWorker"]</xpath>
    <value>
      <li>RimRound.FeedOther.FoodNetworkV2DistillerPlaceWorker</li>
    </value>
  </Operation>
</Patch>

<?xml version='1.0' encoding='utf-8'?>
<Defs>
  <RecipeDef Name="SwellGlow">
    <defName>makeSwellGlow</defName>
    <label>Synthesize Swell-Glow</label>
    <description>Synthesize one authorized metabolic dose from 2 gluttonium and 2 neutroamine. Its energy releases over the product schedule, separately from its chemical high.</description>
    <jobString>Synthesizing Swell-Glow.</jobString>
    <workAmount>1300</workAmount>
    <workSpeedStat>DrugCookingSpeed</workSpeedStat>
    <workSkill>Medicine</workSkill>
    <effectWorking>BurnDrug</effectWorking>
    <requiredGiverWorkType>Crafting</requiredGiverWorkType>
    <researchPrerequisite>RR_Research_GlutoniumDrugs</researchPrerequisite>
    <recipeUsers>
      <li>DrugLab</li>
    </recipeUsers>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>RR_Gluttonium</li>
          </thingDefs>
        </filter>
        <count>2</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>Neutroamine</li>
          </thingDefs>
        </filter>
        <count>2</count>
      </li>
    </ingredients>
    <products>
      <swellGlowOriginal>1</swellGlowOriginal>
    </products>
  </RecipeDef>

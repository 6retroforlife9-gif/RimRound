  <!--Implants-->
  <HediffDef ParentName="RR_ImplantHediffBase">
    <defName>SG_ImplantHediff</defName>
    <label>Swell-Glow implant</label>
    <labelNoun>a swell-glow implant</labelNoun>
    <hediffClass>SwellGlow.SGImplant</hediffClass>
    <initialSeverity>0.05</initialSeverity>
    <alwaysShowSeverity>true</alwaysShowSeverity>
    <description>A calorite gastric implant. In redesigned colonies it improves weight conversion from food by 10% and raises hunger by 10%; only one is active.</description>
    <descriptionHyperlinks>
      <ThingDef>SG_SwellGlowImplant</ThingDef>
    </descriptionHyperlinks>
    <stages>
      <li>
        <hungerRateFactorOffset>0.10</hungerRateFactorOffset>
      </li>
    </stages>
    <spawnThingOnRemoved>SG_SwellGlowImplant</spawnThingOnRemoved>
  </HediffDef>
  <ThingDef ParentName="RimRound_BodyPartBionicBase">
    <defName>SG_SwellGlowImplant</defName>
    <label>swell-glow implant</label>
    <description>A calorite gastric implant made from gluttonium. It improves conversion of food into stored weight by 10%, while raising ordinary hunger by 10%. Redesigned colonies support one active implant; historical Legacy colonies retain their original effect.</description>
    <graphicData>
      <texPath>Things/SwellGlow/SwellGlowImplant</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <descriptionHyperlinks>
      <RecipeDef>SG_InstallSwellGlowImplant</RecipeDef>
    </descriptionHyperlinks>
    <costList>
      <RR_Gluttonium>5</RR_Gluttonium>
      <ComponentIndustrial>1</ComponentIndustrial>
    </costList>
    <thingSetMakerTags>
      <li>RewardStandardMidFreq</li>
    </thingSetMakerTags>
    <statBases>
      <WorkToMake>5280</WorkToMake>
      <Mass>2</Mass>
    </statBases>
    <recipeMaker>
      <skillRequirements>
        <Crafting>8</Crafting>
      </skillRequirements>
      <researchPrerequisite>RR_Research_HungerImplant</researchPrerequisite>
    </recipeMaker>
  </ThingDef>
  <RecipeDef ParentName="SurgeryInstallImplantBase">
    <defName>SG_InstallSwellGlowImplant</defName>
    <label>install swell-glow implant</label>
    <description>Install a swell-glow implant.</description>
    <descriptionHyperlinks>
      <ThingDef>SG_SwellGlowImplant</ThingDef>
      <HediffDef>SG_ImplantHediff</HediffDef>
    </descriptionHyperlinks>
    <workerClass>SwellGlow.Recipe_InstallImplantAllowDuplicates</workerClass>
    <developmentalStageFilter>Adult</developmentalStageFilter>
    <workAmount>3000</workAmount>
    <skillRequirements>
      <Medicine>6</Medicine>
    </skillRequirements>
    <jobString>Installing swell-glow implant.</jobString>
    <ingredients Inherit="False">
      <li>
        <filter>
          <thingDefs>
            <li>SG_SwellGlowImplant</li>
          </thingDefs>
        </filter>
        <count>1</count>
      </li>
      <li>
        <filter>
          <categories>
            <li>Medicine</li>
          </categories>
        </filter>
        <count>2</count>
      </li>
    </ingredients>
    <fixedIngredientFilter Inherit="False">
      <thingDefs>
        <li>SG_SwellGlowImplant</li>
      </thingDefs>
      <categories>
        <li>Medicine</li>
      </categories>
    </fixedIngredientFilter>
    <appliedOnFixedBodyParts>
      <li>Stomach</li>
    </appliedOnFixedBodyParts>
    <addsHediff>SG_ImplantHediff</addsHediff>
  </RecipeDef>
  <!--Food-->
  <ThingDef ParentName="OrganicProductBase">
    <defName>SG_Calomilk</defName>
    <label>calomilk</label>
    <description>Calorite-rich milk. Each unit supplies 0.1 nutrition. Used by explicitly enriched recipes; excluded from everyday cooking defaults.</description>
    <graphicData>
      <texPath>Things/Products/Calomilk</texPath>
    </graphicData>
    <socialPropernessMatters>true</socialPropernessMatters>
    <statBases>
      <MarketValue>2.8</MarketValue>
      <!-- Can be used like meat in recipes -->
      <Mass>0.045</Mass>
      <MaxHitPoints>60</MaxHitPoints>
      <Flammability>0.2</Flammability>
      <Nutrition>0.1</Nutrition>
      <FoodPoisonChanceFixedHuman>0.02</FoodPoisonChanceFixedHuman>
    </statBases>
    <comps>
      <li Class="CompProperties_Rottable">
        <daysToRotStart>14</daysToRotStart>
        <rotDestroys>true</rotDestroys>
      </li>
      <li Class="CompProperties_Ingredients" />
    </comps>
    <ingestible>
      <preferability>RawTasty</preferability>
      <foodType>AnimalProduct, Fluid</foodType>
      <babiesCanIngest>false</babiesCanIngest>
    </ingestible>
    <thingCategories>
      <li>CaloriteIngredients</li>
      <li>AnimalProductRaw</li>
    </thingCategories>
    <allowedArchonexusCount>80</allowedArchonexusCount>
  </ThingDef>
</Defs>
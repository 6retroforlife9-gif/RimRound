        <defName>SG_GeneWeightHate</defName>
        <label>legacy hate opinion marker</label>
        <labelShortAdj>weight-hate</labelShortAdj>
        <description>Legacy opinion marker. Personal body preferences remain under the pawn's own attitude and are not reassigned by this gene.</description>
        <iconPath>Genes/Opinion/WOHate</iconPath>
        <geneClass>SwellGlow.SGGene</geneClass>
        <canGenerateInGeneSet>false</canGenerateInGeneSet>
        <displayOrderInCategory>100</displayOrderInCategory>
        <modExtensions>
            <li Class="SwellGlow.SGTraitExtension">
                <opinionTrait>Hate</opinionTrait>
            </li>
        </modExtensions>
        <exclusionTags>
            <li>WeightOpinionGene</li>
        </exclusionTags>
        <biostatMet>0</biostatMet>
    </GeneDef>

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <AssemblyName>SwellGlow</AssemblyName>
    <RootNamespace>SwellGlow</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>../../Assemblies/</OutputPath>
    <RimWorldGameRoot Condition="'$(RimWorldGameRoot)' == ''">$(MSBuildProjectDirectory)\..\..\..\..\..\..</RimWorldGameRoot>
    <RimWorldWorkshopRoot Condition="'$(RimWorldWorkshopRoot)' == ''">$(RimWorldGameRoot)\..\..\workshop\content\294100</RimWorldWorkshopRoot>
    <RimRoundAssemblyRoot Condition="'$(RimRoundAssemblyRoot)' == ''">$(MSBuildProjectDirectory)\..\..\..\..\Assemblies</RimRoundAssemblyRoot>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="0Harmony">
      <HintPath>$(RimWorldWorkshopRoot)/2009463077/1.6/Assemblies/0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(RimWorldGameRoot)/RimWorldWin64_Data/Managed/Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="RimRound">
      <HintPath>$(RimRoundAssemblyRoot)/RimRound.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(RimWorldGameRoot)/RimWorldWin64_Data/Managed/UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="SGGenePopulation.cs" />
    <Compile Include="SGGene.cs" />
    <Compile Include="SGImplant.cs" />
    <Compile Include="SGTraits.cs" />
    <Compile Include="Properties/AssemblyInfo.cs" />
  </ItemGroup>
</Project>

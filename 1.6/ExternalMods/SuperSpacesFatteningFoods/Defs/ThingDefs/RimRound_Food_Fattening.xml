<?xml version='1.0' encoding='utf-8'?>
<Defs>
  <ThingDef ParentName="RR_SimpleMealBase">
    <defName>FatBurger</defName>
    <label>Lard Filled Burger</label>
    <description>A rich, greasy burger that takes its name as a promise.\n\nBase: 6 nutrition / 0.6 L, before pawn modifiers.\nEnergy is absorbed during digestion.\nConsumed whole; unusable food is wasted.</description>
    <graphicData>
      <texPath>Things/Food/Burger</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <statBases>
      <MarketValue>120</MarketValue>
      <WorkToMake>325</WorkToMake>
      <Nutrition>6</Nutrition>
    </statBases>
    <comps>
      <li Class="RimRound.Comps.CompProperties_FoodItems_NutritionDensity">
        <compClass>RimRound.Comps.ThingComp_FoodItems_NutritionDensity</compClass>
        <fullnessToNutritionRatio>0.1</fullnessToNutritionRatio>
      </li>
    </comps>
  </ThingDef>
  <ThingDef ParentName="RR_SimpleMealBase">
    <defName>Donut</defName>
    <label>Delicious Donut</label>
    <description>A little ring of sweet dough with grand ambitions for your waistline.\n\nBase: 1.8 nutrition / 0.3 L, before pawn modifiers.\nEnergy is absorbed during digestion.\nConsumed whole; unusable food is wasted.</description>
    <graphicData>
      <texPath>Things/Food/Donut</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <statBases>
      <MarketValue>35</MarketValue>
      <WorkToMake>250</WorkToMake>
      <Nutrition>1.8</Nutrition>
    </statBases>
    <comps>
      <li Class="RimRound.Comps.CompProperties_FoodItems_NutritionDensity">
        <compClass>RimRound.Comps.ThingComp_FoodItems_NutritionDensity</compClass>
        <fullnessToNutritionRatio>0.166666666667</fullnessToNutritionRatio>
      </li>
    </comps>
  </ThingDef>
  <ThingDef ParentName="RR_SimpleMealBase">
    <defName>fatpill</defName>
    <label>Test Fat Pill</label>
    <description>A tiny pill with much larger plans for its swallower. Its energy is released gradually.\n\nBase: 12 nutrition / 0.05 L, before pawn modifiers.\nEnergy release: 24 game hours in Fantasy; 72 in Balanced where permitted.\nRequires drug or medical authorization and room for a whole dose. Drug effects apply separately.</description>
    <graphicData>
      <texPath>Things/Food/FatPills</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <statBases>
      <MarketValue>110</MarketValue>
      <WorkToMake>375</WorkToMake>
      <Nutrition>12</Nutrition>
    </statBases>
    <comps>
      <li Class="RimRound.Comps.CompProperties_FoodItems_NutritionDensity">
        <compClass>RimRound.Comps.ThingComp_FoodItems_NutritionDensity</compClass>
        <fullnessToNutritionRatio>0.00416666666667</fullnessToNutritionRatio>
      </li>
      <li Class="CompProperties_Drug" />
    </comps>
    <ingestible>
      <drugCategory>Medical</drugCategory>
      <maxNumToIngestAtOnce>1</maxNumToIngestAtOnce>
      <defaultNumToIngestAtOnce>1</defaultNumToIngestAtOnce>
      <preferability>NeverForNutrition</preferability>
      <foodType>Processed</foodType>
      <canAutoSelectAsFoodForCaravan>false</canAutoSelectAsFoodForCaravan>
    </ingestible>
  </ThingDef>
</Defs>

<Defs>
  <ResearchProjectDef>
    <defName>Oinky_JunkFoods</defName>
    <label>Junk foods</label>
    <description>Prepare dense snacks, sweets, drinks and rich meals from ordinary crops, milk and chocolate.</description>
    <tab>RimRoundTech</tab>
    <baseCost>500</baseCost>
    <techLevel>Industrial</techLevel>
    <researchViewX>2</researchViewX>
    <researchViewY>5</researchViewY>
  </ResearchProjectDef>
  <ThoughtDef>
    <defName>Oinky_EnjoyedJunkFood</defName>
    <thoughtClass>Thought_Memory</thoughtClass>
    <durationDays>1</durationDays>
    <stackLimit>1</stackLimit>
    <stages>
      <li>
        <label>enjoyed junk food</label>
        <description>That was a tasty treat.</description>
        <baseMoodEffect>3</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>
  <ThoughtDef>
    <defName>Oinky_MildJunkFoodCraving</defName>
    <workerClass>Oinky.JunkFood.ThoughtWorker_JunkFoodCraving</workerClass>
    <developmentalStageFilter>Adult</developmentalStageFilter>
    <validWhileDespawned>true</validWhileDespawned>
    <stages>
      <li>
        <label>craving a treat</label>
        <description>I got used to having snacks. I could go for something sweet.</description>
        <baseMoodEffect>-2</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

<?xml version="1.0" encoding="utf-8" ?>
<Defs>
	<ResearchProjectDef>  
		<defName>RR_Research_SyntheticDigestion</defName>
		<label>synthetic digestion</label>
		<tab>RimRoundTech</tab>
		<description>Craft metabolic implants for faster digestion with a smaller stomach capacity.</description>
		<baseCost>2000</baseCost>
		<requiredResearchBuilding>HiTechResearchBench</requiredResearchBuilding>
		<requiredResearchFacilities>
			<li>MultiAnalyzer</li>
		</requiredResearchFacilities>
		<techLevel>Spacer</techLevel>
		<prerequisites>
			<li>Fabrication</li>
			<li>Bionics</li>
		</prerequisites>		
		<researchViewX>0</researchViewX>
		<researchViewY>2</researchViewY>
	</ResearchProjectDef>
	
	<ResearchProjectDef>  
		<defName>RR_Research_HungerImplant</defName>
		<label>hunger implant</label>
		<tab>RimRoundTech</tab>
		<description>Create an appetite regulator that expands stomach capacity while increasing ordinary hunger.</description>
		<baseCost>1600</baseCost>
		<requiredResearchBuilding>HiTechResearchBench</requiredResearchBuilding>
		<requiredResearchFacilities>
			<li>MultiAnalyzer</li>
		</requiredResearchFacilities>
		<techLevel>Spacer</techLevel>
		<prerequisites>
			<li>RR_Research_SyntheticDigestion</li>
		</prerequisites>		
		<researchViewX>1</researchViewX>
		<researchViewY>2</researchViewY>
	</ResearchProjectDef>	
	
	<ResearchProjectDef>  
		<defName>RR_Research_AIEncouragement</defName>
		<label>AI encouragement</label>
		<tab>RimRoundTech</tab>
		<description>Craft a neural encouragement chip that modestly improves digestion and mood at the cost of consciousness.</description>
		<baseCost>4000</baseCost>
		<requiredResearchBuilding>HiTechResearchBench</requiredResearchBuilding>
		<requiredResearchFacilities>
			<li>MultiAnalyzer</li>
		</requiredResearchFacilities>
		<techLevel>Spacer</techLevel>
		<prerequisites>
			<li>RR_Research_HungerImplant</li>
		</prerequisites>		
		<researchViewX>2</researchViewX>
		<researchViewY>2</researchViewY>
	</ResearchProjectDef>
	<ResearchProjectDef>
		<defName>RR_Research_ArchotechAdaptation</defName>
		<label>exceptional metabolic adaptation</label>
		<tab>RimRoundTech</tab>
		<description>Produce an expensive implant for extraordinary digestion and capacity, with greater hunger and difficult surgery.</description>
		<baseCost>6000</baseCost>
		<requiredResearchBuilding>HiTechResearchBench</requiredResearchBuilding>
		<requiredResearchFacilities><li>MultiAnalyzer</li></requiredResearchFacilities>
		<techLevel>Ultra</techLevel>
		<prerequisites><li>RR_Research_SyntheticDigestion</li><li>RR_Research_AIEncouragement</li></prerequisites>
		<researchViewX>3</researchViewX>
		<researchViewY>2</researchViewY>
	</ResearchProjectDef>
</Defs>

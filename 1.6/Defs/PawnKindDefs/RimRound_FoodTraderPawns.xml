<?xml version='1.0' encoding='utf-8'?>
<Defs>
  <PawnKindDef ParentName="OutlanderBase">
    <defName>RR_FoodMerchant</defName>
    <initialWillRange>2~4</initialWillRange>
    <initialResistanceRange>12~20</initialResistanceRange>
    <label>food merchant</label>
    <combatPower>90</combatPower>
    <trader>true</trader>
    <isFighter>true</isFighter>
    <minGenerationAge>24</minGenerationAge>
    <maxGenerationAge>55</maxGenerationAge>
    <chemicalAddictionChance>0</chemicalAddictionChance>
    <gearHealthRange>1~1</gearHealthRange>
    <itemQuality>Normal</itemQuality>
    <minApparelQuality>Normal</minApparelQuality>
    <maxApparelQuality>Normal</maxApparelQuality>
    <apparelMoney>1400~1800</apparelMoney>
    <apparelAllowHeadgearChance>1</apparelAllowHeadgearChance>
    <weaponMoney>1000~1000</weaponMoney>
    <forceWeaponQuality>Normal</forceWeaponQuality>
    <requiredWorkTags>Violent</requiredWorkTags>
    <weaponTags>
      <li>RR_FoodSidearm</li>
    </weaponTags>
    <apparelRequired>
      <li>Apparel_FlakVest</li>
      <li>Apparel_SimpleHelmet</li>
      <li>RR_HoverChair</li>
    </apparelRequired>
    <skills>
      <li>
        <skill>Shooting</skill>
        <range>8~12</range>
      </li>
      <li>
        <skill>Social</skill>
        <range>8~14</range>
      </li>
    </skills>
    <modExtensions>
      <li Class="RimRound.FeedOther.FoodTraderPawnExtension">
        <startingMassKg>340~400</startingMassKg>
      </li>
    </modExtensions>
  </PawnKindDef>

<?xml version='1.0' encoding='utf-8'?>
<Defs>
  <ThingDef ParentName="ArmorSmithableBase" Name="RRHoverChair">
    <defName>RR_HoverChair</defName>
    <label>hoverchair</label>
    <description>A sturdy hoverchair for getting a heavy body moving again. A helper can fit it at the bedside.\n\n25 kg; 300 hit points. Both appearances work alike, need no batteries and have no body-weight limit.\nThe wearer must be able to operate the controls; unconsciousness and pain shock still prevent movement.</description>
    <useHitPoints>true</useHitPoints>
    <category>Item</category>
    <graphicData>
      <texPath>Things/Pawn/Humanlike/Apparel/Hoverchair/hoverchair</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <statBases>
      <DeteriorationRate>0</DeteriorationRate>
      <Flammability>0</Flammability>
      <Beauty>0</Beauty>
      <MaxHitPoints>300</MaxHitPoints>
      <WorkToMake>3600</WorkToMake>
      <Mass>25</Mass>
      <StuffEffectMultiplierArmor>0</StuffEffectMultiplierArmor>
      <StuffEffectMultiplierInsulation_Cold>0</StuffEffectMultiplierInsulation_Cold>
      <StuffEffectMultiplierInsulation_Heat>0</StuffEffectMultiplierInsulation_Heat>
      <EquipDelay>3.0</EquipDelay>
    </statBases>
    <comps>
      <li>
        <compClass>CompAttachBase</compClass>
      </li>
    </comps>
    <thingCategories>
      <li>ApparelUtility</li>
    </thingCategories>
    <recipeMaker>
      <researchPrerequisite>Machining</researchPrerequisite>
      <recipeUsers Inherit="False">
        <li>TableMachining</li>
      </recipeUsers>
      <skillRequirements>
        <Crafting>5</Crafting>
      </skillRequirements>
    </recipeMaker>
    <costList>
      <Steel>80</Steel>
      <ComponentIndustrial>4</ComponentIndustrial>
    </costList>
    <apparel>
      <countsAsClothingForNudity>false</countsAsClothingForNudity>
      <bodyPartGroups>
        <li>Waist</li>
      </bodyPartGroups>
      <wornGraphicPath>Things/Pawn/Humanlike/Apparel/Hoverchair/hoverchair</wornGraphicPath>
      <layers>
        <li>Shell</li>
      </layers>
    </apparel>
    <tickerType>Normal</tickerType>
    <receivesSignals>true</receivesSignals>
    <soundImpactDefault>BulletImpact_Metal</soundImpactDefault>
  </ThingDef>
  <ThingDef ParentName="RRHoverChair">
    <defName>RR_HoverChairArm</defName>
    <label>hoverchair with arm rests</label>
    <description>A sturdy hoverchair for getting a heavy body moving again. A helper can fit it at the bedside.\n\n25 kg; 300 hit points. Both appearances work alike, need no batteries and have no body-weight limit.\nThe wearer must be able to operate the controls; unconsciousness and pain shock still prevent movement.</description>
    <apparel>
      <wornGraphicPath>Things/Pawn/Humanlike/Apparel/Hoverchair/hoverchairArm</wornGraphicPath>
    </apparel>
  </ThingDef>
</Defs>
<?xml version="1.0" encoding="utf-8" ?>
<Defs>
	<!--Hunger Drone Ship-->
  <ThingDef ParentName="CrashedShipPartBase">
    <defName>FatteningDroneShipPart</defName>
    <label>ship part (hunger driver)</label>
    <description>An ancient ship part containing a hostile hunger driver. It targets one gender of humanlike pawn, increasing hunger and nutritional expenditure to 1.5 times normal, then 2 times after one day and 3 times after two days. It does not destroy plants. Destroy the ship part to stop its signal; the remaining effect fades shortly afterward.</description>
    <drawPlaceWorkersWhileSelected>true</drawPlaceWorkersWhileSelected>
    <graphicData>
      <texPath>Things/Building/Exotic/CrashedRRPsychicShip</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(6,3)</drawSize>
      <shadowData><volume>(0.9, 1.0, 0.9)</volume></shadowData>
      <damageData><rect>(0.5, 0.1, 5, 2.8)</rect></damageData>
    </graphicData>
    <comps>
      <li Class="RimRound.Comps.CompProperties_CausesGameCondition_HungerDrone">
        <conditionDef>RR_HungerDrone</conditionDef>
        <worldRange>1</worldRange>
        <droneLevelIncreaseInterval>60000</droneLevelIncreaseInterval>
        <droneLevel>1</droneLevel>
      </li>
    </comps>	
  </ThingDef>  
  
  <IncidentDef>
    <defName>RR_HungerDrone</defName>
    <label>ship part crash (hunger driver)</label>
    <targetTags>
      <li>Map_PlayerHome</li>
    </targetTags>
    <workerClass>IncidentWorker_CrashedShipPart</workerClass>
    <letterLabel>Hunger driver ship</letterLabel>
    <letterText>A large piece of an ancient ship has crashed nearby.\n\nIts hostile hunger driver targets one gender of humanlike pawn, increasing hunger and nutritional expenditure. The signal intensifies once per day, reaching three times normal after two days.\n\nDestroy the ship part to stop the signal. Beware of its mechanoid defenders.</letterText>
    <letterDef>ThreatSmall</letterDef>
    <baseChance>2.0</baseChance>
    <baseChanceWithRoyalty>0.4</baseChanceWithRoyalty>
    <minRefireDays>15</minRefireDays>
    <tags>
      <li>MechanoidShip</li>
    </tags>
    <refireCheckTags>
      <li>MechanoidShip</li>
    </refireCheckTags>
    <category>ThreatBig</category>
    <pointsScaleable>true</pointsScaleable>
    <minThreatPoints>300</minThreatPoints>
    <mechClusterBuilding>FatteningDroneShipPart</mechClusterBuilding>
    <tale>ShipPartCrash</tale>
  </IncidentDef>

  <GameConditionDef>
    <defName>RR_HungerDrone</defName>
    <conditionClass>RimRound.AI.GameCondition_PsychicHungerIncrease</conditionClass>
    <label>hunger driver</label>
    <description>A hunger driver targets {0} humanlike pawns in this region. Their hunger and nutritional expenditure are {1} times normal. The strongest signal applies; opposite-gender pawns are unaffected. Destroy the source ship part to stop the signal; the remaining effect fades shortly afterward.</description>
    <letterText>A hostile hunger driver has begun affecting this region.</letterText>
    <canBePermanent>false</canBePermanent>
  </GameConditionDef>  
  

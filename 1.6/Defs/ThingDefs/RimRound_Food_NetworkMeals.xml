<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <!-- These are larger nutrient-paste servings, not cooked-meal quality or
       recipes. MealBase supplies vanilla ingredients and food poisoning;
       the existing paste-only patch does not match these new defNames. -->
  <ThingDef Name="RR_NetworkMealBase" ParentName="MealBase" Abstract="True">
    <description>A larger serving of nutrient paste drawn from a food network. Its ingredient, spoilage and poisoning state comes from the source batch.</description>
    <graphicData>
      <texPath>Things/Item/Meal/NutrientPaste</texPath>
      <graphicClass>Graphic_MealVariants</graphicClass>
    </graphicData>
    <ingestible>
      <preferability>MealAwful</preferability>
      <ateEvent>AteNutrientPaste</ateEvent>
      <ingestEffect>EatVegetarian</ingestEffect>
      <ingestSound>Meal_Eat</ingestSound>
      <optimalityOffsetFeedingAnimals>-25</optimalityOffsetFeedingAnimals>
    </ingestible>
    <comps>
      <li Class="CompProperties_Rottable">
        <daysToRotStart>0.75</daysToRotStart>
        <rotDestroys>true</rotDestroys>
      </li>
      <li Class="RimRound.FeedOther.CompProperties_FoodNetworkServing">
        <compClass>RimRound.FeedOther.CompFoodNetworkServing</compClass>
      </li>
    </comps>
  </ThingDef>

  <ThingDef ParentName="RR_NetworkMealBase">
    <defName>RR_NetworkMealLarge</defName>
    <label>large network paste meal</label>
    <statBases>
      <MarketValue>16.67</MarketValue>
      <Mass>0.73</Mass>
      <Nutrition>1.5</Nutrition>
    </statBases>
  </ThingDef>

  <ThingDef ParentName="RR_NetworkMealBase">
    <defName>RR_NetworkMealHuge</defName>
    <label>huge network paste meal</label>
    <statBases>
      <MarketValue>27.78</MarketValue>
      <Mass>1.22</Mass>
      <Nutrition>2.5</Nutrition>
    </statBases>
  </ThingDef>

  <ThingDef ParentName="RR_NetworkMealBase">
    <defName>RR_NetworkMealEnormous</defName>
    <label>enormous network paste meal</label>
    <statBases>
      <MarketValue>44.44</MarketValue>
      <Mass>1.96</Mass>
      <Nutrition>4</Nutrition>
    </statBases>
  </ThingDef>

  <ThingDef ParentName="RR_NetworkMealBase">
    <defName>RR_NetworkMealMassive</defName>
    <label>massive network paste meal</label>
    <statBases>
      <MarketValue>66.67</MarketValue>
      <Mass>2.93</Mass>
      <Nutrition>6</Nutrition>
    </statBases>
  </ThingDef>

  <ThingDef ParentName="RR_NetworkMealBase">
    <defName>RR_NetworkMealColossal</defName>
    <label>colossal network paste meal</label>
    <statBases>
      <MarketValue>166.67</MarketValue>
      <Mass>7.33</Mass>
      <Nutrition>15</Nutrition>
    </statBases>
  </ThingDef>
</Defs>

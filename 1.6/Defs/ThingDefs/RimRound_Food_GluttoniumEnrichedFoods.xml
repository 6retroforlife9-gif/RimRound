<Defs>
  <ThingDef Abstract="True" Name="RR_GluttoniumProductsBase" ParentName="OrganicProductBase">
    <graphicData>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <thingCategories>
      <li>Foods</li>
    </thingCategories>
    <socialPropernessMatters>true</socialPropernessMatters>
    <statBases>
      <FoodPoisonChanceFixedHuman>0</FoodPoisonChanceFixedHuman>
    </statBases>
    <ingestible>
      <preferability>MealLavish</preferability>
      <foodType>OmnivoreHuman</foodType>
      <!--tasteThought>AteKibble</tasteThought-->
      <optimalityOffsetHumanlikes>-10</optimalityOffsetHumanlikes>
      <optimalityOffsetFeedingAnimals>-100</optimalityOffsetFeedingAnimals>
      <ingestEffect>EatVegetarian</ingestEffect>
      <ingestSound>RawVegetable_Eat</ingestSound>
    </ingestible>
    <allowedArchonexusCount>10</allowedArchonexusCount>
  </ThingDef>
  <ThingDef ParentName="RR_GluttoniumProductsBase">
    <defName>RR_CrammedCroissant</defName>
    <label>crammed croissant</label>
    <description>Contains 4.5 nutrition in 0.6 stomach volume before pawn modifiers. Energy is absorbed as this food digests. Whole items are consumed; any portion that cannot be used is wasted.</description>
    <graphicData>
      <texPath>Things/Item/GluttoniumFood/CrammedCroissant</texPath>
    </graphicData>
    <statBases>
      <WorkToMake>2400</WorkToMake>
      <MarketValue>110</MarketValue>
      <Mass>1.6</Mass>
      <Nutrition>4.5</Nutrition>
    </statBases>
    <ingestible />
    <comps>
      <li Class="RimRound.Comps.CompProperties_FoodItems_NutritionDensity">
        <compClass>RimRound.Comps.ThingComp_FoodItems_NutritionDensity</compClass>
        <fullnessToNutritionRatio>0.133333333333</fullnessToNutritionRatio>
      </li>
      <li Class="CompProperties_Ingredients" />
    </comps>
  </ThingDef>

    <description>A flaky pastry with a great deal more fattening potential than its innocent appearance suggests.\n\nBase: 4.5 nutrition / 0.6 L, before pawn modifiers.\nEnergy is absorbed during digestion.\nConsumed whole; unusable food is wasted.</description>
    <graphicData>
      <texPath>Things/Item/GluttoniumFood/CrammedCroissant</texPath>
    </graphicData>
    <statBases>
      <WorkToMake>2400</WorkToMake>
      <MarketValue>110</MarketValue>
      <Mass>1.6</Mass>
      <Nutrition>4.5</Nutrition>
    </statBases>
    <ingestible />
    <comps>
      <li Class="RimRound.Comps.CompProperties_FoodItems_NutritionDensity">
        <compClass>RimRound.Comps.ThingComp_FoodItems_NutritionDensity</compClass>
        <fullnessToNutritionRatio>0.133333333333</fullnessToNutritionRatio>
      </li>
      <li Class="CompProperties_Ingredients" />
    </comps>
  </ThingDef>

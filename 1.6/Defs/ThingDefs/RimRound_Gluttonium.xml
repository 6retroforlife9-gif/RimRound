<?xml version='1.0' encoding='utf-8'?>
<Defs>
  <ThingDef ParentName="RockBase">
    <defName>RR_GluttoniumOre</defName>
    <label>gluttonium ore</label>
    <description>Natural deposits of gluttonium, a scarce specialist reagent. Mining provides small quantities before industrial synthesis is researched.</description>
    <graphicData>
      <texPath>Things/Building/Linked/Gluttonium_Atlas</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>CutoutComplex</shaderType>
    </graphicData>
    <statBases>
      <MaxHitPoints>3000</MaxHitPoints>
    </statBases>
    <building>
      <isResourceRock>true</isResourceRock>
      <mineableThing>RR_Gluttonium</mineableThing>
      <mineableYield>2</mineableYield>
      <mineableScatterCommonality>1.00</mineableScatterCommonality>
      <!-- as often as steel, with smaller blotches -->
      <mineableScatterLumpSizeRange>3~6</mineableScatterLumpSizeRange>
    </building>
    <comps>
      <li Class="CompProperties_Glower">
        <glowRadius>4</glowRadius>
        <glowColor>(77,190,37,0)</glowColor>
        <colorPickerEnabled>true</colorPickerEnabled>
        <darklightToggle>true</darklightToggle>
      </li>
    </comps>
  </ThingDef>
  <ThingDef ParentName="ResourceBase">
    <defName>RR_Gluttonium</defName>
    <label>gluttonium</label>
    <description>A specialist industrial reagent for named metabolic recipes and devices. Not edible raw and not a general crafting material. Balanced manufacturing consumes steel and chemfuel; power-only replication requires Fantasy mode.</description>
    <graphicData>
      <texPath>Things/Item/Resource/Gluttonium</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
    </graphicData>
    <soundInteract>Metal_Drop</soundInteract>
    <soundDrop>Metal_Drop</soundDrop>
    <useHitPoints>false</useHitPoints>
    <healthAffectsPrice>false</healthAffectsPrice>
    <statBases>
      <MarketValue>21</MarketValue>
      <Mass>3</Mass>
      <Beauty>-1</Beauty>
    </statBases>
    <thingCategories>
      <li>Manufactured</li>
    </thingCategories>
    <deepCommonality>0.5</deepCommonality>
    <deepCountPerPortion>8</deepCountPerPortion>
    <deepLumpSizeRange>1~4</deepLumpSizeRange>
    <burnableByRecipe>false</burnableByRecipe>
    <smeltable>false</smeltable>
    <stuffProps>
      <appearance>Metal</appearance>
      <commonality>0</commonality>
      <constructEffect>ConstructMetal</constructEffect>
      <color>(160,178,181)</color>
      <soundImpactBullet>BulletImpact_Metal</soundImpactBullet>
      <soundImpactMelee>BulletImpact_Metal</soundImpactMelee>
      <soundMeleeHitSharp>MeleeHit_Metal_Sharp</soundMeleeHitSharp>
      <soundMeleeHitBlunt>MeleeHit_Metal_Blunt</soundMeleeHitBlunt>
      <categories Inherit="False" />
    </stuffProps>
    <terrainAffordanceNeeded>Medium</terrainAffordanceNeeded>
    <allowedArchonexusCount>80</allowedArchonexusCount>
  </ThingDef>
</Defs>
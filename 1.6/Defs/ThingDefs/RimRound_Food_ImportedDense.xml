<?xml version='1.0' encoding='utf-8'?>
<Defs>
  <ThingDef ParentName="RR_SimpleMealBase">
    <defName>RR_DenseSimple2x</defName>
    <label>2x dense simple meal</label>
    <description>A concentrated simple meal imported by food traders.\n\n1.8 nutrition in a standard 0.9 L portion. Keep refrigerated.</description>
    <tradeability>All</tradeability>
    <graphicData>
      <texPath>Things/Item/Meal/Simple</texPath>
      <graphicClass>Graphic_MealVariants</graphicClass>
    </graphicData>
    <statBases>
      <MarketValue>30</MarketValue>
      <Nutrition>1.8</Nutrition>
      <Mass>.44</Mass>
    </statBases>
    <comps>
      <li Class="RimRound.Comps.CompProperties_FoodItems_NutritionDensity">
        <compClass>RimRound.Comps.ThingComp_FoodItems_NutritionDensity</compClass>
        <fullnessToNutritionRatio>0.500000000000</fullnessToNutritionRatio>
      </li>
    </comps>
  </ThingDef>

<Defs>
  <ResearchProjectDef>
    <defName>RR_Research_KitchenEquipment</defName>
    <label>kitchen workwear</label>
    <tab>RimRoundTech</tab>
    <description>Make practical workwear for cooks handling large meals.</description>
    <baseCost>600</baseCost>
    <techLevel>Industrial</techLevel>
    <prerequisites><li>ComplexClothing</li></prerequisites>
    <researchViewX>2</researchViewX>
    <researchViewY>3</researchViewY>
  </ResearchProjectDef>

  <ThingDef ParentName="ApparelBase">
    <defName>RR_KitchenWorkSmock</defName>
    <label>kitchen work smock</label>
    <description>A heavy, washable smock with pockets for a cook who has a lot of mouths to feed.\n\nIncreases cooking speed while worn. The bonus improves with quality: +15% at Normal and +30% at Legendary. Worn on the skin layer.\n\nCraft at either tailoring bench after researching Kitchen workwear in the RimRound research tab.</description>
    <thingCategories><li>ApparelMisc</li></thingCategories>
    <stuffCategories><li>Fabric</li><li>Leathery</li></stuffCategories>
    <costStuffCount>80</costStuffCount>
    <graphicData><texPath>Things/Item/Equipment/NovaTech/NOVATECH_JUMPSUIT</texPath><graphicClass>Graphic_Single</graphicClass></graphicData>
    <statBases><MaxHitPoints>100</MaxHitPoints><WorkToMake>3000</WorkToMake><Mass>1.4</Mass><EquipDelay>2</EquipDelay></statBases>
    <recipeMaker>
      <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
      <workSkill>Crafting</workSkill>
      <researchPrerequisite>RR_Research_KitchenEquipment</researchPrerequisite>
      <recipeUsers><li>ElectricTailoringBench</li><li>HandTailoringBench</li></recipeUsers>
    </recipeMaker>
    <apparel>
      <wornGraphicPath>FillerTexture</wornGraphicPath>
      <bodyPartGroups><li>Torso</li><li>Shoulders</li></bodyPartGroups>
      <layers><li>OnSkin</li></layers>
    </apparel>
  </ThingDef>
</Defs>

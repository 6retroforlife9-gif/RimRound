<?xml version='1.0' encoding='utf-8'?>
<Defs>
  <ThingDef Abstract="True" Name="UltraTechClothingBase" ParentName="ApparelBase">
    <techLevel>Spacer</techLevel>
    <graphicData>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <uiIconScale>1.4</uiIconScale>
    <recipeMaker>
      <displayPriority>200</displayPriority>
      <workSkill>Crafting</workSkill>
    </recipeMaker>
    <thingCategories>
      <li>Apparel</li>
    </thingCategories>
    <tradeTags>
      <li>Clothing</li>
      <li>Armor</li>
      <li>HiTechArmor</li>
    </tradeTags>
    <generateCommonality>0</generateCommonality>
    <colorGenerator Class="ColorGenerator_Options">
      <options>
        <li>
          <weight>10</weight>
          <only>(0.9,0.9,0.9,1)</only>
        </li>
      </options>
    </colorGenerator>
    <apparel>
      <countsAsClothingForNudity>true</countsAsClothingForNudity>
      <tags>
        <li>IndustrialMilitaryBasic</li>
      </tags>
      <defaultOutfitTags>
        <li>Soldier</li>
      </defaultOutfitTags>
      <developmentalStageFilter>Child, Adult</developmentalStageFilter>
    </apparel>
    <thingSetMakerTags>
      <li>RewardStandardHighFreq</li>
    </thingSetMakerTags>
  </ThingDef>
  <!--recipeUsers Inherit="False">
		<li>ElectricTailoringBench</li>
		<li>HandTailoringBench</li>
		<li>FabricationBench</li>
		<li>ElectricSmithy</li>
		<li>FueledSmithy</li>
	</recipeUsers>
				<ComponentSpacer>1</ComponentSpacer>
			<Plasteel>30</Plasteel>
	
	
	-->
  <ThingDef ParentName="UltraTechClothingBase">
    <defName>RimRound_NovaTechApparel_Jumpsuit</defName>
    <label>NovaTech jumpsuit</label>
    <description>Flexible workwear: digestion +10%, movement +5%, and 5% less weight movement penalty. It occupies the skin layer and offers modest armor. Children can wear it for native clothing protection; metabolic bonuses apply only to eligible adults.</description>
    <modExtensions>
      <li Class="RimRound.Defs.ClothingModExtension">
        <digestionSpeedMultBonus>.10</digestionSpeedMultBonus>
        <flatMoveBonus>.05</flatMoveBonus>
        <movementPenaltyMitigationMultBonus_Weight>.05</movementPenaltyMitigationMultBonus_Weight>
      </li>
    </modExtensions>
    <graphicData>
      <texPath>Things/Item/Equipment/NovaTech/NOVATECH_JUMPSUIT</texPath>
    </graphicData>
    <recipeMaker>
      <researchPrerequisite>RR_Research_MetabolicTextiles</researchPrerequisite>
      <recipeUsers>
        <li>ElectricTailoringBench</li>
        <li>HandTailoringBench</li>
      </recipeUsers>
    </recipeMaker>
    <statBases>
      <Beauty>-2</Beauty>
      <MaxHitPoints>120</MaxHitPoints>
      <Flammability>0.2</Flammability>
      <WorkToMake>3000</WorkToMake>
      <Mass>1.4</Mass>
      <ArmorRating_Sharp>0.15</ArmorRating_Sharp>
      <ArmorRating_Blunt>0.08</ArmorRating_Blunt>
      <ArmorRating_Heat>0.2</ArmorRating_Heat>
      <Insulation_Cold>7</Insulation_Cold>
      <Insulation_Heat>4</Insulation_Heat>
      <EquipDelay>3</EquipDelay>
      <DeteriorationRate>2</DeteriorationRate>
    </statBases>
    <apparel>
      <bodyPartGroups>
        <li>Torso</li>
        <li>Legs</li>
        <li>Shoulders</li>
      </bodyPartGroups>
      <wornGraphicPath>FillerTexture</wornGraphicPath>
      <layers>
        <li>OnSkin</li>
      </layers>
    </apparel>
    <comps>
      <li Class="RimRound.Defs.CompProperties_ProgressionApparel" />
    </comps>
    <costList Inherit="False">
      <Cloth>60</Cloth>
      <ComponentIndustrial>2</ComponentIndustrial>
    </costList>
  </ThingDef>
  <ThingDef ParentName="UltraTechClothingBase">
    <defName>RimRound_NovaTechApparel_Belt</defName>
    <label>NovaTech belt</label>
    <description>A supportive waist belt: stomach capacity +5%, elasticity +10%, digestion +10%, and 5% less fullness movement penalty. It uses the belt slot and is heavy. Children can wear it for native clothing protection; metabolic bonuses apply only to eligible adults.</description>
    <modExtensions>
      <li Class="RimRound.Defs.ClothingModExtension">
        <softLimitMultiplier>.05</softLimitMultiplier>
        <stomachElasticityMultBonus>.10</stomachElasticityMultBonus>
        <digestionSpeedMultBonus>.10</digestionSpeedMultBonus>
        <movementPenaltyMitigationMultBonus_Fullness>.05</movementPenaltyMitigationMultBonus_Fullness>
      </li>
    </modExtensions>
    <graphicData>
      <texPath>Things/Item/Equipment/NovaTech/NOVATECH_BELT</texPath>
    </graphicData>
    <recipeMaker>
      <researchPrerequisite>RR_Research_MetabolicTextiles</researchPrerequisite>
      <recipeUsers Inherit="False">
        <li>TableMachining</li>
      </recipeUsers>
    </recipeMaker>
    <statBases>
      <Beauty>1</Beauty>
      <MaxHitPoints>100</MaxHitPoints>
      <Flammability>0.1</Flammability>
      <WorkToMake>2400</WorkToMake>
      <Mass>2.5</Mass>
      <EquipDelay>2</EquipDelay>
      <DeteriorationRate>2</DeteriorationRate>
    </statBases>
    <apparel>
      <countsAsClothingForNudity>false</countsAsClothingForNudity>
      <wornGraphicPath>FillerTexture</wornGraphicPath>
      <bodyPartGroups>
        <li>Waist</li>
      </bodyPartGroups>
      <layers>
        <li>Belt</li>
      </layers>
    </apparel>
    <comps>
      <li Class="RimRound.Defs.CompProperties_ProgressionApparel" />
    </comps>
    <costList Inherit="False">
      <Cloth>30</Cloth>
      <Steel>20</Steel>
      <ComponentIndustrial>1</ComponentIndustrial>
    </costList>
  </ThingDef>
  <ThingDef ParentName="UltraTechClothingBase">
    <defName>RimRound_NovaTechApparel_ProtoSuit</defName>
    <label>NovaTech proto-suit</label>
    <description>Advanced metabolic workwear: weight conversion +15%, digestion +25%, movement +10%, and manipulation +5%. Expensive materials and the skin slot limit its use. Children can wear it for native clothing protection; metabolic bonuses apply only to eligible adults.</description>
    <modExtensions>
      <li Class="RimRound.Defs.ClothingModExtension">
        <weightGainMultiplierMultBonus>.15</weightGainMultiplierMultBonus>
        <digestionSpeedMultBonus>.25</digestionSpeedMultBonus>
        <flatMoveBonus>.10</flatMoveBonus>
        <flatManipulationBonus>.05</flatManipulationBonus>
      </li>
    </modExtensions>
    <graphicData>
      <texPath>Things/Item/Equipment/NovaTech/NOVATECH_PROTOSUIT</texPath>
    </graphicData>
    <costList>
      <Hyperweave>75</Hyperweave>
      <ComponentSpacer>3</ComponentSpacer>
      <Gold>10</Gold>
    </costList>
    <recipeMaker>
      <researchPrerequisite>RR_Research_UltraTechMetabolicTextiles</researchPrerequisite>
      <recipeUsers>
        <li>FabricationBench</li>
      </recipeUsers>
    </recipeMaker>
    <statBases>
      <Beauty>1</Beauty>
      <MaxHitPoints>180</MaxHitPoints>
      <Flammability>0.1</Flammability>
      <WorkToMake>12000</WorkToMake>
      <Mass>2.5</Mass>
      <ArmorRating_Sharp>0.35</ArmorRating_Sharp>
      <ArmorRating_Blunt>0.15</ArmorRating_Blunt>
      <ArmorRating_Heat>0.4</ArmorRating_Heat>
      <Insulation_Cold>11</Insulation_Cold>
      <Insulation_Heat>7</Insulation_Heat>
      <EquipDelay>4.5</EquipDelay>
      <DeteriorationRate>2</DeteriorationRate>
    </statBases>
    <apparel>
      <bodyPartGroups>
        <li>Torso</li>
        <li>Legs</li>
        <li>Shoulders</li>
      </bodyPartGroups>
      <wornGraphicPath>FillerTexture</wornGraphicPath>
      <layers>
        <li>OnSkin</li>
      </layers>
    </apparel>
    <comps>
      <li Class="RimRound.Defs.CompProperties_ProgressionApparel" />
    </comps>
  </ThingDef>
